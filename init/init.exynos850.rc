import /vendor/etc/init/hw/init.mainline.rc

# bring-up: S-Boot forces loglevel=4, print everything to the pstore console
on early-init
    write /proc/sys/kernel/printk "8 4 1 7"

# Mount
on fs
    mkdir /mnt/vendor/efs 0771 root root

    # Mount everything that does not require fsck
    mount_all --early

# Wi-Fi and Bluetooth
on post-fs
    # Factory addresses, read by the drivers when they are first enabled
    copy /mnt/vendor/efs/wifi/.mac.info /sys/module/scsc_wlan/parameters/mac_addr
    copy /mnt/vendor/efs/bluetooth/bt_addr /sys/module/scsc_bt/parameters/bd_addr

on late-fs
    # Mount RW partitions which need run fsck
    mount_all --late
